# Copy to .env.local and set the address printed by the ESP32 in Serial Monitor.
# The IP below is only an EXAMPLE - your ESP32 will very likely have a different one.
VITE_ESP32_WS_URL=ws://192.168.1.120:81

# Telemetry older than this (milliseconds) is shown as STALE. ESP32 sends every 200 ms.
VITE_TELEMETRY_STALE_MS=1500

# How long to wait for a commandAck before reporting a timeout (milliseconds).
VITE_COMMAND_TIMEOUT_MS=3000
